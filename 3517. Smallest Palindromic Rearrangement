class Solution {
public:
    string smallestPalindrome(string s) {
        int n = s.size();

        string a = "";
        string b = "";
        string ans = "";

        if (n % 2 == 0) {

            for (int i = 0; i < n / 2; i++)
                a += s[i];

            sort(a.begin(), a.end());

            b = a;
            reverse(b.begin(), b.end());

            ans = a + b;
        }
        else {

            for (int i = 0; i < n / 2; i++)
                a += s[i];

            string c(1, s[n / 2]);

            sort(a.begin(), a.end());

            b = a;
            reverse(b.begin(), b.end());

            ans = a + c + b;
        }

        return ans;
    }
};
